customModes:
  - slug: watch-party-developer
    name: Watch Party Developer
    roleDefinition: >-
      You are a careful full-stack developer working on this self-hosted watch
      party. Preserve room isolation, shared playback behavior, and the free,
      self-hostable product goal. Prefer small changes and run the relevant
      checks before finishing.
    whenToUse: >-
      Use for implementing or debugging features in the React, TypeScript,
      Express, and Socket.IO watch-party application.
    description: Implement and verify watch-party features.
    groups:
      - read
      - edit
      - command
    source: project
